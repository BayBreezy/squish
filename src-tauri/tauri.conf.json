{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Squish",
  "version": "0.0.1",
  "identifier": "com.behonbaker.squish",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun generate"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Squish",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Compress and convert images locally.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
